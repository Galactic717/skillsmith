{
  "version": 2,
  "setup": [],
  "protected": ["tests/acceptance/**"],
  "checks": [
    {"id": "A1", "title": "Adding trials keeps them sorted by end date", "covers": ["R1"], "type": "command", "run": "node tests/acceptance/add-trial.mjs", "expect": {"includes": "sorted: Spotify, Netflix"}, "weight": 3},
    {"id": "A2", "title": "The home page shows the headline", "covers": ["R2"], "type": "http", "start": "node server.mjs", "url": "http://127.0.0.1:{{port}}/", "expect": {"status": 200, "includes": "Never pay for a forgotten trial"}, "timeout": 30, "weight": 2},
    {"id": "A3", "title": "The README says how to start it", "covers": ["R3"], "type": "file_contains", "path": "README.md", "pattern": "node server.mjs"},
    {"id": "A4", "title": "No live payment keys in the code", "covers": ["R3"], "type": "not_contains", "glob": "**/*.{js,mjs,html}", "pattern": "sk_live_", "guard": true}
  ]
}
