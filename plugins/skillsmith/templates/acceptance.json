{
  "version": 2,
  "setup": ["npm install --no-audit --no-fund"],
  "protected": ["tests/acceptance/**"],
  "checks": [
    {
      "id": "A1",
      "title": "Adding a trial with an end date shows it in the list",
      "covers": ["R1"],
      "type": "command",
      "run": "node --test tests/acceptance/add-trial.test.mjs",
      "weight": 3
    },
    {
      "id": "A2",
      "title": "The home page opens and shows the main headline",
      "covers": ["R2"],
      "type": "http",
      "start": "npm run start",
      "url": "http://localhost:{{port}}/",
      "expect": {"status": 200, "includes": "Never pay for a forgotten trial"},
      "timeout": 90,
      "weight": 2
    },
    {
      "id": "A3",
      "title": "README explains how to run the product",
      "covers": ["R3"],
      "type": "file_contains",
      "path": "README.md",
      "pattern": "npm run start",
      "weight": 1
    },
    {
      "id": "A4",
      "title": "No live payment keys in the code",
      "covers": ["R3"],
      "type": "not_contains",
      "glob": "**/*.{js,mjs,ts,tsx,html,json}",
      "pattern": "sk_live_",
      "guard": true,
      "weight": 1
    }
  ]
}
