{
  "description": "Skillsmith: remind Claude where the project stands at session start; lock protected arena files against edits.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/skillsmith.mjs\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/skillsmith.mjs\" hook pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
