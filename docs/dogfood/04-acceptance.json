{
  "version": 2,
  "setup": [],
  "protected": ["engine/test/**", "docs/dogfood/04-acceptance.json"],
  "checks": [
    {"id": "A1", "title": "The plugin manifest exists", "covers": ["R9"], "type": "file_exists", "path": "plugins/skillsmith/.claude-plugin/plugin.json"},
    {"id": "A2", "title": "The marketplace points to the plugin", "covers": ["R9"], "type": "file_contains", "path": ".claude-plugin/marketplace.json", "pattern": "./plugins/skillsmith"},
    {"id": "A3", "title": "No top-level bin/ folder, so Cowork can install it", "covers": ["R9"], "type": "file_absent", "path": "plugins/skillsmith/bin", "guard": true},
    {"id": "A4", "title": "Claude Code accepts the marketplace and the plugin in strict mode", "covers": ["R9"], "type": "command", "run": "claude plugin validate . --strict && claude plugin validate ./plugins/skillsmith --strict", "timeout": 180, "weight": 3},
    {"id": "A5", "title": "The engine runs and lists the arena commands", "covers": ["R5"], "type": "command", "run": "node plugins/skillsmith/engine/skillsmith.js help", "expect": {"includes": "arena verify <team>|--all"}},
    {"id": "A6", "title": "The Law says liars are deleted", "covers": ["R5"], "type": "file_contains", "path": "plugins/skillsmith/skills/start/references/law.md", "pattern": "The team that files it is\\s+deleted", "regex": true},
    {"id": "A7", "title": "The interview includes the idea check", "covers": ["R1"], "type": "file_contains", "path": "plugins/skillsmith/skills/interview/SKILL.md", "pattern": "## The idea check"},
    {"id": "A8", "title": "Our own brief passes the interview gate", "covers": ["R1"], "type": "command", "run": "node plugins/skillsmith/engine/skillsmith.js gate interview --from docs/dogfood"},
    {"id": "A9", "title": "Our own sources file is valid", "covers": ["R2"], "type": "command", "run": "node plugins/skillsmith/engine/skillsmith.js sources check docs/dogfood/02-sources.json"},
    {"id": "A10", "title": "Our own research passes the research gate", "covers": ["R2"], "type": "command", "run": "node plugins/skillsmith/engine/skillsmith.js gate research --from docs/dogfood"},
    {"id": "A11", "title": "Our launch copy passes the slop detector", "covers": ["R3"], "type": "command", "run": "node plugins/skillsmith/engine/skillsmith.js slop docs/dogfood/03-hooks.md"},
    {"id": "A12", "title": "Our launch copy passes the hooks gate", "covers": ["R3"], "type": "command", "run": "node plugins/skillsmith/engine/skillsmith.js gate hooks --from docs/dogfood"},
    {"id": "A13", "title": "Every requirement of Skillsmith has a check", "covers": ["R4"], "type": "command", "run": "node plugins/skillsmith/engine/skillsmith.js acceptance trace --from docs/dogfood", "expect": {"includes": "Coverage: 100%"}},
    {"id": "A14", "title": "The engine can seal hidden checks and prove checks can fail", "covers": ["R4", "R6"], "type": "command", "run": "node plugins/skillsmith/engine/skillsmith.js help", "expect": {"matches": "holdout seal[\\s\\S]*acceptance vacuity|acceptance vacuity[\\s\\S]*holdout seal"}},
    {"id": "A15", "title": "The end-to-end arena test covers deaths, hidden checks and a forged verdict", "covers": ["R5", "R6", "R7"], "type": "file_contains", "path": "engine/test/arena.test.ts", "pattern": "changed after Skillsmith wrote it"},
    {"id": "A16", "title": "The ledger is signed with an HMAC key", "covers": ["R7"], "type": "file_contains", "path": "engine/src/core/ledger.ts", "pattern": "createHmac('sha256'"},
    {"id": "A17", "title": "The whole engine test suite passes", "covers": ["R5", "R6", "R7"], "type": "command", "run": "npm test", "timeout": 900, "weight": 5},
    {"id": "A18", "title": "The README tells a founder how to install it", "covers": ["R8", "R9"], "type": "file_contains", "path": "README.md", "pattern": "/plugin marketplace add galactic717/skillsmith"},
    {"id": "A19", "title": "The plugin is written in English only", "covers": ["R8"], "type": "not_contains", "glob": "plugins/skillsmith/**/*.{md,json,js}", "pattern": "[\\u0400-\\u04FF]", "regex": true}
  ]
}
